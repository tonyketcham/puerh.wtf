		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"@typescript-eslint/eslint-plugin": "5.32.0",
		"@typescript-eslint/parser": "5.32.0",
		"autoprefixer": "10.4.8",
		"d3-shape": "3.1.0",
		"eslint": "8.21.0",
		"eslint-config-next": "^14.0.0",
