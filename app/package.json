{
	"name": "puerh.wtf",
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@9.12.2",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"codegen": "flatbread codegen",
		"liquor": "node scripts/liquor-colors.mjs",
		"perf:interaction": "node scripts/explorer-perf.mjs",
		"geo": "node scripts/geo/build.mjs",
		"geo:check": "node scripts/geo/check.mjs",
		"geo:test": "node scripts/geo/test.mjs",
		"dev": "flatbread start -X npx \"next dev --turbopack\"",
		"dev:no-turbopack": "flatbread start -X npx \"next dev\"",
		"build": "flatbread start -X npx \"next build\"",
		"start": "next start",
		"test": "playwright test",
		"test:dev": "playwright test",
		"test:export": "playwright test --config playwright.export.config.ts",
		"test:server": "node --test scripts/serve-export.test.mjs",
		"lint": "eslint .",
		"format": "prettier --write --plugin-search-dir=. .",
		"cms:dev": "node server/cms/dev.mjs",
		"cms:test": "node --test server/cms/*.test.mjs",
		"authoring:assets": "node src/lib/authoring/media/prepare-codecs.mjs && node scripts/authoring-images.mjs",
		"predev": "pnpm authoring:assets",
		"prebuild": "pnpm authoring:assets"
	},
	"devDependencies": {
		"@flatbread/codegen": "1.0.0-alpha.2",
		"@flatbread/resolver-svimg": "1.0.0-alpha.0",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@neodrag/svelte": "1.2.3",
		"@playwright/test": "1.59.1",
		"@swc-jotai/debug-label": "^0.2.0",
		"@swc-jotai/react-refresh": "^0.3.0",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/typography": "0.5.16",
		"@types/d3-contour": "3.0.6",
		"@types/d3-geo": "3.1.1",
		"@types/flubber": "^0.4.0",
		"@types/node": "^20.0.0",
		"@types/pngjs": "6.0.5",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "8.59.2",
		"@typescript-eslint/parser": "8.59.2",
		"d3-contour": "4.0.2",
		"d3-geo": "3.1.1",
		"d3-shape": "3.1.0",
		"eslint": "9.39.4",
		"eslint-config-next": "16.2.5",
		"eslint-config-prettier": "8.5.0",
		"flatbread": "1.0.0-alpha.22",
		"graphql-request": "4.3.0",
		"gray-matter": "4.0.3",
		"hast-util-parse-selector": "3.1.0",
		"hast-util-select": "5.0.2",
		"mapshaper": "0.6.113",
		"next": "16.2.5",
		"plur": "5.1.0",
		"pngjs": "7.0.0",
		"postcss": "^8.4.16",
		"postcss-scrollbar": "0.5.1",
		"prettier": "3.9.10",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"sharp": "^0.35.5",
		"subset-font": "2.9.0",
		"tailwindcss": "4.1.11",
		"tailwindcss-textshadow": "2.1.3",
		"tslib": "2.4.0",
		"typescript": "6.0.3",
		"unist-util-visit": "4.1.0"
	},
	"dependencies": {
		"@chenglou/pretext": "^1.0.0",
		"@floating-ui/react": "^0.27.12",
		"@floating-ui/react-dom": "^2.1.3",
		"@headlessui/react": "^2.2.4",
		"@jsquash/resize": "2.1.1",
		"@jsquash/webp": "1.5.0",
		"@tanstack/react-virtual": "3.13.10",
		"@types/d3-shape": "^3.1.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"flubber": "0.4.2",
		"jotai": "^2.12.5",
		"jotai-location": "^0.6.1",
		"layercake": "^7.1.0",
		"lucide-react": "^0.522.0",
		"motion": "^12.18.1",
		"react-icons": "^5.5.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"simplebar-react": "^3.3.1",
		"tailwind-merge": "^3.3.1",
		"tailwindcss-animate": "^1.0.7",
		"yaml": "^2.9.1"
	}
}
