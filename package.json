{
  "name": "puerh.wtf-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter puerh.wtf dev",
    "build": "pnpm --filter puerh.wtf build && pnpm --filter log build",
    "test": "pnpm --filter puerh.wtf test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "graphql": "^16.0.1"
      }
    }
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.4"
  }
}
